# Variaveis de ambiente do pulseboard. Copie para .env e ajuste.

# Conexao do Prisma com o PostgreSQL (padrao do docker-compose).
DATABASE_URL=postgresql://pulseboard:pulseboard@localhost:5432/pulseboard

# Conexao direta (sem pool) usada pelo Prisma Migrate. Com docker-compose
# local, pode repetir a DATABASE_URL.
DATABASE_URL_UNPOOLED=postgresql://pulseboard:pulseboard@localhost:5432/pulseboard

# Credenciais e porta do container PostgreSQL.
POSTGRES_USER=pulseboard
POSTGRES_PASSWORD=pulseboard
POSTGRES_DB=pulseboard
POSTGRES_PORT=5432

# Driver de persistencia: vazio = Prisma/PostgreSQL; "memory" = modo demo
# sem banco (dados de exemplo em memoria, resetados a cada reinicio).
# DB_DRIVER=memory
